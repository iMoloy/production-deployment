# ==============================================================================
# NexusAgent Studio — Production Environment Variables (FE-11)
# ==============================================================================

# Core App Configuration
NEXT_PUBLIC_APP_NAME="NexusAgent Studio"
NEXT_PUBLIC_APP_ENV="production"
NEXT_PUBLIC_SITE_URL="https://nexusagent-production.vercel.app"

# AI Provider API Keys
# If ANTHROPIC_API_KEY is not provided, the platform automatically engages
# high-fidelity simulated streaming with full Generative UI tool execution.
ANTHROPIC_API_KEY=""

# Production Hygiene & Rate Limiting Controls
RATE_LIMIT_MAX_REQUESTS="5"
RATE_LIMIT_WINDOW_SEC="60"
MAX_PROMPT_CHARS="2000"
MAX_MESSAGE_HISTORY="30"
